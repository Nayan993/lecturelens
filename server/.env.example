NODE_ENV=development
# optional: debug | info | warn | error | silent (default: debug in development, info otherwise)
LOG_LEVEL=
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=
# at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# relative paths are resolved from the repository root (./storage = <repo>/storage, git-ignored)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=512
