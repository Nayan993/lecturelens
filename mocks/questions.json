    {
      "id": "6650c3a0c3b2e41d8a600005",
      "lectureId": "6650c3a0c3b2e41d8a100001",
      "topicId": "6650c3a0c3b2e41d8a400003",
      "type": "mcq",
      "difficulty": "medium",
      "stem": "For f = (x + y)·z with x = −2, y = 5 and z = −4, what is ∂f/∂x?",
      "options": [
        {
          "id": "a",
          "text": "−4"
        },
        {
          "id": "b",
          "text": "3"
        },
        {
          "id": "c",
          "text": "1"
        },
        {
          "id": "d",
          "text": "−12"
        }
      ],
      "correctOptionId": "a",
      "explanation": "With q = x + y, ∂f/∂q = z = −4 and ∂q/∂x = 1, so by the chain rule ∂f/∂x = −4 × 1 = −4.",
      "evidence": [
        {
          "chunkId": "6650c3a0c3b2e41d8a300009",
          "startSec": 780.301,
          "endSec": 802.958,
          "quote": "Take x equals negative two, y equals five, z equals negative four."
        },
        {
          "chunkId": "6650c3a0c3b2e41d8a30000a",
          "startSec": 832.975,
          "endSec": 862.044,
          "quote": "d f by d x equals d f by d q times one, which is negative four"
        }
      ],
      "status": "approved",
      "rejectionReason": null,
      "reviewNote": null,
      "reviewedBy": "6650c3a0c3b2e41d8a000001",
