    {
      "id": "6650c3a0c3b2e41d8a600002",
      "lectureId": "6650c3a0c3b2e41d8a100001",
      "topicId": "6650c3a0c3b2e41d8a400001",
      "type": "mcq",
      "difficulty": "medium",
      "stem": "Running gradient descent on L(w) = w² from w = 1, which learning rate makes the iterates diverge?",
      "options": [
        {
          "id": "a",
          "text": "η = 0.1"
        },
        {
          "id": "b",
          "text": "η = 0.5"
        },
        {
          "id": "c",
          "text": "η = 0.9"
        },
        {
          "id": "d",
          "text": "η = 1.1"
        }
      ],
      "correctOptionId": "d",
      "explanation": "Each step multiplies w by (1 − 2η). For η = 1.1 the multiplier is −1.2, whose magnitude exceeds 1, so |w| grows every step and the loss blows up.",
      "evidence": [
        {
          "chunkId": "6650c3a0c3b2e41d8a300004",
          "startSec": 357.43,
          "endSec": 385.149,
          "quote": "with eta equal to one point one, the multiplier is negative one point two"
        },
        {
          "chunkId": "6650c3a0c3b2e41d8a300004",
          "startSec": 331.403,
          "endSec": 357,
          "quote": "It still converges, but it oscillates back and forth across the minimum."
        }
      ],
      "status": "approved",
      "rejectionReason": null,
      "reviewNote": null,
      "reviewedBy": "6650c3a0c3b2e41d8a000001",
      "reviewedAt": "2026-10-21T09:32:02.312Z",
      "model": "llama-3.3-70b-versatile",
      "promptVersion": "mcq-v1",
      "createdAt": "2026-10-20T15:12:08.377Z",
      "updatedAt": "2026-10-21T09:32:02.312Z"
    },
    {
      "id": "6650c3a0c3b2e41d8a600003",
      "lectureId": "6650c3a0c3b2e41d8a100001",
      "topicId": "6650c3a0c3b2e41d8a400002",
      "type": "mcq",
      "difficulty": "medium",
      "stem": "A training set has 50,000 examples and the mini-batch size is 100. How many iterations make up one epoch?",
      "options": [
        {
          "id": "a",
          "text": "100"
        },
        {
          "id": "b",
          "text": "500"
        },
        {
          "id": "c",
          "text": "5,000"
        },
        {
          "id": "d",
          "text": "50,000"
        }
      ],
      "correctOptionId": "b",
      "explanation": "One iteration processes one mini-batch and one epoch is a full pass over the data, so 50,000 / 100 = 500 iterations.",
      "evidence": [
        {
          "chunkId": "6650c3a0c3b2e41d8a300007",
          "startSec": 568.51,
          "endSec": 593.967,
          "quote": "with fifty thousand examples and a batch size of one hundred, one epoch is five hundred iterations"
        }
      ],
      "status": "approved",
