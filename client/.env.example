VITE_API_BASE_URL=http://localhost:5000/api/v1

# Which data domains use the fixture-backed mock adapters instead of the real API.
#   all   = everything is mocked (the UI works with no backend running)
#   none  = everything calls the real backend at VITE_API_BASE_URL (what production ships)
#   a comma-separated list mocks only those domains
# Domains: auth, lectures, transcript, topics, summaries, search, qa, quizzes, revision
# Unset: `all` under `npm run dev`, `none` in a production build — fixtures never ship as data.
#
# Current integration state: auth and lectures are real; A/B/C domains answer 501 on the real
# API, so local development mocks them until their modules land. With `none` they show a calm
# "coming soon" panel instead.
VITE_USE_MOCKS=transcript,topics,summaries,search,qa,quizzes,revision

# Show the plainly labelled "Demo accounts" block on /login (docs/CONTRACTS.md §9).
# Always shown when auth is mocked; set to true for a demo against the seeded real server
# (never in a production build).
VITE_SHOW_DEMO_ACCOUNTS=false

# Mock mode only: fixture lectures have no real recording. Point this at a local video
# (e.g. put one in client/public/dev-media/, which is git-ignored) so the player works in demos.
# VITE_MOCK_MEDIA_URL=/dev-media/lecture7.mp4

# Largest upload the client accepts, in MB. Keep equal to the server's MAX_UPLOAD_MB.
VITE_MAX_UPLOAD_MB=512
